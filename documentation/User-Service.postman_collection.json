					"name": "Create Tenant",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data._id) {",
									"        pm.environment.set('createdTenantId', response.data._id);",
									"        console.log('Created tenant ID saved: ' + response.data._id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"{{tenantName}}\",\n  \"domain\": \"{{tenantDomain}}\"\n}"
						},
						"url": {
							"raw": "{{baseURL}}/tenants",
							"host": [
								"{{baseURL}}"
							],
							"path": [
								"tenants"
							]
						},
						"description": "Create new tenant. Requires 'tenant.create' permission. Automatically saves created tenant ID."
					},
					"response": []
				},
				{
					"name": "Update Tenant",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
